PMP_NA4_M:
  config:
    - check ISA:=regex(.*32.*); check ISA:=regex(.*I.*Zicsr.*); def rvtest_mtrap_routine=True;
  mnemonics:
    "{lw, sw, lb, sb, lh, sh, jal, jalr}": 0
  csr_comb:
    # All 5 cases checked here.
    # Checks for required permissions.
    ((pmpcfg1 >> {16, 8, 0}) & 0xFF == (({${PMP_CFG_LRWX}, ${PMP_CFG_LRX}, ${PMP_CFG_LRW}}{[$1]}) | ${PMP_CFG_NA4})): 0
    ((pmpcfg0 >> {24, 16}) & 0xFF == (({${PMP_CFG_LR}, ${PMP_CFG_LX}}{[$1]}) | ${PMP_CFG_NA4})): 0
  val_comb:
    # Check that lb..ld or sb..sd accessed an address inside the TEST_FOR_EXECUTION PMP region
    # and that at that time the pmpaddr with NA4 region was selected.
    ? (mnemonic == {"lw", "lh", "lb", "sw", "sh", "sb"}) and
      pmp_rgn_chk(rs1_val | imm_val, access_len, "NA4", (pmpaddr{5,4,3})) and
      ((pmpcfg1 >> {16, 8, 0}{[$2]}) & 0xFF == {${PMP_CFG_LRWX}, ${PMP_CFG_LRX}, ${PMP_CFG_LRW}}{[$2]} | ${PMP_CFG_NA4})
    : 0
    
    # Checks for the faults.
    # Check for store access faults.
    ? (mnemonic == {"sw", "sh", "sb"}) and
      ((pmpcfg1 >> 8) & 0xFF == ${PMP_CFG_LRX} | ${PMP_CFG_NA4}) and
      mcause == ${CAUSE_STORE_ACCESS}
    : 0
    ? (mnemonic == {"sw", "sh", "sb"}) and
      ((pmpcfg0 >> {24, 16}) & 0xFF == {${PMP_CFG_LR}, ${PMP_CFG_LX}}{[$2]} | ${PMP_CFG_NA4}) and
      mcause == ${CAUSE_STORE_ACCESS}
    : 0
    # Check for load access faults.
    ? (mnemonic == {"lw", "lh", "lb"}) and
      ((pmpcfg0 >> 16) & 0xFF == (${PMP_CFG_LX} | ${PMP_CFG_NA4})) and
      mcause == ${CAUSE_LOAD_ACCESS}
    : 0

    # Check for fetch access faults.
    ? ((pmpcfg1 >> 0) & 0xFF == ${PMP_CFG_LRW} | ${PMP_CFG_NA4}) and
      mcause == ${CAUSE_FETCH_ACCESS}
    : 0
    ? ((pmpcfg0 >> 24) & 0xFF == ${PMP_CFG_LR} | ${PMP_CFG_NA4}) and
      mcause == ${CAUSE_FETCH_ACCESS}
    : 0

PMP_NAPOT_M:
  config:
  - check ISA:=regex(.*32.*); check ISA:=regex(.*I.*S.*Zicsr.*);  def rvtest_mtrap_routine=True;
  mnemonics:
    "{lw, sw, lb, sb, lh, sh, jal, jalr}" : 0
  csr_comb:
    #All 5 cases checked here.
    #checks for required permissions.
    ((pmpcfg3 >> {8, 0}) & 0xFF == {${PMP_CFG_LRWX}, ${PMP_CFG_LRX}}{[$1]} | ${PMP_CFG_NAPOT}): 0
    ((pmpcfg2 >> {24, 16, 8}) & 0xFF == {${PMP_CFG_LRW}, ${PMP_CFG_LR}, ${PMP_CFG_LX}}{[$1]} | ${PMP_CFG_NAPOT}): 0
  val_comb:
    #check the lw, lh, lb, sw, sh, sb accessed the address which was inside the TEST_FOR_EXECUTION PMP region at least once and at that time the pmpaddr with NAPOT region selected.
    ? (mnemonic == {"lw", "lh", "lb", "sw", "sh", "sb"}) and
      pmp_rgn_chk(rs1_val | imm_val, access_len, "NAPOT", (pmpaddr{11,10,9})) and
      ((pmpcfg2 >> {24, 16, 8}{[$2]}) & 0xFF == {${PMP_CFG_LRW}, ${PMP_CFG_LR}, ${PMP_CFG_LX}}{[$2]} | ${PMP_CFG_NAPOT})
    : 0
    ? (mnemonic == {"lw", "lh", "lb", "sw", "sh", "sb"}) and
      pmp_rgn_chk(rs1_val | imm_val, access_len, "NAPOT", (pmpaddr{13,12})) and
      ((pmpcfg3 >> {8, 0}{[$2]}) & 0xFF == {${PMP_CFG_LRWX}, ${PMP_CFG_LRX}}{[$2]} | ${PMP_CFG_NAPOT})
    : 0
    #checks for the faults.
    #check for store access faults
    ? (mnemonic == {"sw", "sh", "sb"}) and
      ((pmpcfg2 >> {16, 8}) & 0xFF == {${PMP_CFG_LR}, ${PMP_CFG_LX}}{[$2]} | ${PMP_CFG_NAPOT}) and
      mcause == ${CAUSE_STORE_ACCESS}
    : 0
    ? (mnemonic == {"sw", "sh", "sb"}) and
      ((pmpcfg3 >> 0) & 0xFF == ${PMP_CFG_LRX} | ${PMP_CFG_NAPOT}) and
      mcause == ${CAUSE_STORE_ACCESS}
    : 0
    #check for Load access faults
    ? (mnemonic == {"lw", "lh", "lb"}) and
      ((pmpcfg2 >> 8) & 0xFF == ${PMP_CFG_LX} | ${PMP_CFG_NAPOT}) and
      mcause == ${CAUSE_LOAD_ACCESS}
    : 0
    #check for Fetch access faults
    ? ((pmpcfg2 >> {24, 16}) & 0xFF == {${PMP_CFG_LRW}, ${PMP_CFG_LR}}{[$1]} | ${PMP_CFG_NAPOT}) and
      mcause == ${CAUSE_FETCH_ACCESS}
    : 0
    
PMP_NAPOT_S_U:
  config:
  - check ISA:=regex(.*32.*); check ISA:=regex(.*I.*S.*Zicsr.*);  def rvtest_mtrap_routine=True;
  mnemonics:
    "{lw, sw, lb, sb, lh, sh, jal, jalr}" : 0
  val_comb:
    ? (mnemonic == {"lw", "lh", "lb", "sw", "sh", "sb"}) and
      pmp_rgn_chk(rs1_val | imm_val, access_len, "NAPOT", (pmpaddr13)) and
      ((pmpcfg3 >> 8) & 0xFF ==  ${PMP_CFG_RWX} | ${PMP_CFG_NAPOT})
    : 0
    ? (mnemonic == {"lw", "lh", "lb", "sw", "sh", "sb"}) and
      pmp_rgn_chk(rs1_val | imm_val, access_len, "NAPOT", (pmpaddr{11,10,9})) and
      ((pmpcfg2 >> {24, 16, 8}{[$2]}) & 0xFF == {${PMP_CFG_RW}, ${PMP_CFG_R}, ${PMP_CFG_X}}{[$2]} | ${PMP_CFG_NAPOT})
    : 0
    #checks for the faults.
    #check for store access faults
    ? (mnemonic == {"sw", "sh", "sb"}) and
      ((pmpcfg2 >> {16, 8}) & 0xFF == {${PMP_CFG_R}, ${PMP_CFG_X}}{[$2]} | ${PMP_CFG_NAPOT}) and
      mcause == ${CAUSE_STORE_ACCESS}
    : 0
    ? (mnemonic == {"sw", "sh", "sb"}) and
      ((pmpcfg3 >> ${PMP0_CFG_SHIFT}) & 0xFF == ${PMP_CFG_RX} | ${PMP_CFG_NAPOT}) and
      mcause == ${CAUSE_STORE_ACCESS}
    : 0
    #check for Load access faults
    ? (mnemonic == {"lw", "lh", "lb"}) and
      ((pmpcfg2 >> 8) & 0xFF == ${PMP_CFG_X} | ${PMP_CFG_NAPOT}) and
      mcause == ${CAUSE_LOAD_ACCESS}
    : 0
    #check for Fetch access faults
    ? ((pmpcfg2 >> {24, 16}) & 0xFF == {${PMP_CFG_RW}, ${PMP_CFG_R}}{[$1]} | ${PMP_CFG_NAPOT}) and
      mcause == ${CAUSE_FETCH_ACCESS}
    : 0

        
PMP_TOR_M:
  config:
    - check ISA:=regex(.*32.*); check ISA:=regex(.*I.*S.*Zicsr.*); def rvtest_mtrap_routine=True;
  mnemonics:
    "{lw, sw, lb, sb, lh, sh, jal, jalr}": 0
  csr_comb:
    # All 5 cases checked here.
    # Checks for required permissions.
    ((pmpcfg3 >> 8) & 0xFF == ${PMP_CFG_LRWX} | ${PMP_CFG_TOR}): 0
    ((pmpcfg2 >> {24, 8}) & 0xFF == {${PMP_CFG_LRX}, ${PMP_CFG_LRW}}{[$1]} | ${PMP_CFG_TOR}): 0
    ((pmpcfg1 >> {24, 8}) & 0xFF == {${PMP_CFG_LR}, ${PMP_CFG_LX}}{[$1]} | ${PMP_CFG_TOR}): 0
  val_comb:
    ? (mnemonic == {"lw", "lh", "lb", "sw", "sh", "sb"}) and
      pmp_rgn_chk(rs1_val | imm_val, access_len, "TOR", (pmpaddr13), (pmpaddr12)) and
      ((pmpcfg3 >> 8) & 0xFF ==  ${PMP_CFG_LRWX} | ${PMP_CFG_TOR})
    : 0
    ? (mnemonic == {"lw", "lh", "lb", "sw", "sh", "sb"}) and
      pmp_rgn_chk(rs1_val | imm_val, access_len, "TOR", (pmpaddr{11,9}), (pmpaddr{10, 8}{[$2]})) and
      ((pmpcfg2 >> {24, 8}{[$2]}) & 0xFF == {${PMP_CFG_LRX}, ${PMP_CFG_LRW}}{[$2]} | ${PMP_CFG_TOR})
    : 0        
    ? (mnemonic == {"lw", "lh", "lb", "sw", "sh", "sb"}) and
      pmp_rgn_chk(rs1_val | imm_val, access_len, "TOR", (pmpaddr{7,5}), (pmpaddr{6,4}{[$2]})) and
      ((pmpcfg1 >> {24, 8}{[$2]}) & 0xFF == {${PMP_CFG_LR}, ${PMP_CFG_LX}}{[$2]} | ${PMP_CFG_TOR})
    : 0
    #check for store access faults
    ? (mnemonic == {"sw", "sh", "sb"}) and
      ((pmpcfg2 >> {24, 8}) & 0xFF == {${PMP_CFG_LRX}, ${PMP_CFG_LRW}}{[$2]} | ${PMP_CFG_TOR}) and
      mcause == ${CAUSE_STORE_ACCESS}
    : 0
    ? (mnemonic == {"sw", "sh", "sb"}) and
      ((pmpcfg1 >> {24, 8}) & 0xFF == {${PMP_CFG_LR}, ${PMP_CFG_LX}}{[$2]} | ${PMP_CFG_TOR}) and
      mcause == ${CAUSE_STORE_ACCESS}
    : 0
    ? (mnemonic == {"lw", "lh", "lb"}) and
      ((pmpcfg1 >> 8) & 0xFF == ${PMP_CFG_LX} | ${PMP_CFG_TOR}) and
      mcause == ${CAUSE_LOAD_ACCESS}
    : 0
    #check for Fetch access faults
    ? ((pmpcfg1 >> {24, 8}) & 0xFF == {${PMP_CFG_LR}, ${PMP_CFG_LX}}{[$1]} | ${PMP_CFG_TOR}) and
      mcause == ${CAUSE_FETCH_ACCESS}
    : 0
    ? ((pmpcfg1 >> 24) & 0xFF == ${PMP_CFG_LR} | ${PMP_CFG_TOR}) and
      mcause == ${CAUSE_FETCH_ACCESS}
    : 0
    
PMP_TOR_S_U:
  config:
  - check ISA:=regex(.*32.*); check ISA:=regex(.*I.*S.*Zicsr.*);  def rvtest_mtrap_routine=True;
  mnemonics:
       "{lw, sw, lb, sb, lh, sh, jal, jalr}" : 0
  csr_comb:
    #All 5 cases checked here.
    #checks for required permissions.
    (mode == {'S', 'U'}) and ((pmpcfg0 >> ${PMP1_CFG_SHIFT}) & 0xFF == {${PMP_CFG_RWX}, ${PMP_CFG_RX}, ${PMP_CFG_RW}, ${PMP_CFG_R}, ${PMP_CFG_X}} | ${PMP_CFG_TOR}): 0
  val_comb:
    ? (mode == {'S', 'U'}) and (mnemonic == {"lw", "lh", "lb", "sw", "sh", "sb"}) and
      pmp_rgn_chk(rs1_val | imm_val, access_len, "TOR", (pmpaddr1), (pmpaddr0)) and
      ((pmpcfg0 >> ${PMP1_CFG_SHIFT}) & 0xFF == {${PMP_CFG_RWX}, ${PMP_CFG_RX}, ${PMP_CFG_RW}, ${PMP_CFG_R}, ${PMP_CFG_X}} | ${PMP_CFG_TOR})
    : 0
# #checks for the faults.
    # #check for store access faults
    ? (mode == {'S', 'U'}) and (mnemonic == {"sw", "sh", "sb"}) and
      ((pmpcfg0 >> ${PMP1_CFG_SHIFT}) & 0xFF == {${PMP_CFG_RX}, ${PMP_CFG_R}, ${PMP_CFG_X}} | ${PMP_CFG_TOR}) and
      mcause == ${CAUSE_STORE_ACCESS}
    : 0

    #check for load access faults
    ? (mode == {'S', 'U'}) and (mnemonic == {"lw", "lh", "lb"}) and
      ((pmpcfg0 >> ${PMP1_CFG_SHIFT}) & 0xFF == ${PMP_CFG_X} | ${PMP_CFG_TOR}) and
      mcause == ${CAUSE_LOAD_ACCESS}
    : 0

    #check for fetch access faults
    ? ((pmpcfg0 >> ${PMP1_CFG_SHIFT}) & 0xFF == {${PMP_CFG_RW},${PMP_CFG_R}} | ${PMP_CFG_TOR}) and
      mcause == ${CAUSE_FETCH_ACCESS}
    : 0
PMP_NA4_S_U:
  config:
  - check ISA:=regex(.*32.*); check ISA:=regex(.*I.*S.*Zicsr.*);  def rvtest_mtrap_routine=True;
  mnemonics:
    "{lw, sw, lb, sb, lh, sh, jal, jalr}" : 0
  csr_comb:
    #All 5 cases checked here.
    #checks for required permissions.
    (mode == {'S', 'U'}) and ((pmpcfg0 >> 16) & 0xFF == ${PMP_CFG_R}| ${PMP_CFG_NA4}): 0
    (mode == {'S', 'U'}) and ((pmpcfg0 >> 8) & 0xFF == ${PMP_CFG_X}| ${PMP_CFG_NA4}): 0
    (mode == {'S', 'U'}) and ((pmpcfg1 >> 16) & 0xFF == ${PMP_CFG_RWX} | ${PMP_CFG_NA4}): 0
    (mode == {'S', 'U'}) and ((pmpcfg1 >> 8) & 0xFF == ${PMP_CFG_RX} | ${PMP_CFG_NA4}): 0
    (mode == {'S', 'U'}) and ((pmpcfg1 >> 0) & 0xFF == ${PMP_CFG_RW} | ${PMP_CFG_NA4}): 0
  val_comb:    
    ? (mnemonic == {"lw", "lh", "lb", "sw", "sh", "sb"}) and
      pmp_rgn_chk(rs1_val | imm_val, access_len, "NA4", (pmpaddr{2,1})) and
      ((pmpcfg0 >> {16, 8}{[$2]}) & 0xFF == {${PMP_CFG_R}, ${PMP_CFG_X}}{[$2]} | ${PMP_CFG_NA4})
    : 0 
    ? (mnemonic == {"lw", "lh", "lb", "sw", "sh", "sb"}) and
      pmp_rgn_chk(rs1_val | imm_val, access_len, "NA4", (pmpaddr{5,4,3})) and
      ((pmpcfg1 >> {16, 8, 0}{[$2]}) & 0xFF == {${PMP_CFG_RWX}, ${PMP_CFG_RX}, ${PMP_CFG_RW}}{[$2]} | ${PMP_CFG_NA4})
    : 0    
 #checks for the faults.
    #check for store access faults
    ? (mnemonic == {"sw", "sh", "sb"}) and
      ((pmpcfg1 >> 8) & 0xFF == ${PMP_CFG_RX} | ${PMP_CFG_NA4}) and
      mcause == ${CAUSE_STORE_ACCESS}
    : 0
    ? (mnemonic == {"sw", "sh", "sb"}) and
      ((pmpcfg0 >> {16, 8}) & 0xFF == {${PMP_CFG_R}, ${PMP_CFG_X}}{[$2]} | ${PMP_CFG_NA4}) and
      mcause == ${CAUSE_STORE_ACCESS}
    : 0
    #check for Load access faults
    ? (mnemonic == {"lw", "lh", "lb"}) and
      ((pmpcfg0 >> 8) & 0xFF == ${PMP_CFG_X} | ${PMP_CFG_NA4}) and
      mcause == ${CAUSE_LOAD_ACCESS}
    : 0
    #check for Fetch access faults
    ? ((pmpcfg1 >> ${PMP0_CFG_SHIFT}) & 0xFF == ${PMP_CFG_RW} | ${PMP_CFG_NA4}) and
      mcause == ${CAUSE_FETCH_ACCESS}
    : 0
    ? ((pmpcfg0 >> ${PMP2_CFG_SHIFT}) & 0xFF == ${PMP_CFG_R} | ${PMP_CFG_NA4}) and
      mcause == ${CAUSE_FETCH_ACCESS}
    : 0
    
